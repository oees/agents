# Copy to .env for compose (cp .env.example .env). Local placeholders only; never real values.
# Production values live in App Platform (see .do/app.yaml), never in a file.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DATABASE_URL=postgres://postgres:postgres@db:5432/app
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# Read only by config.settings.production.
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# Host port of the compose db. Set it when 5432 is in use, and pass the same value to make:
# make check-fast POSTGRES_PORT=5433
# POSTGRES_PORT=5432

# compose runs its tool containers as uid:gid 1000:1000. Set these when `id -u` or
# `id -g` differs, so files the containers write into the checkout stay yours.
# HOST_UID=1000
# HOST_GID=1000
