# Copy to .env for local development. Placeholder, local-only values; never put real credentials here.
# compose.yml overrides the database hosts with the `db` service name inside containers.
APP_ENV=local
APP_NAME=app
LOG_LEVEL=DEBUG
DOCS_ENABLED=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_test
HTTP_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=3
HTTP_CONNECT_RETRIES=2
HTTP_MAX_ATTEMPTS=3
WEB_CONCURRENCY=1
